
**`docker-compose.yml`**
```yaml
version: '3.8'

services:
  app:
    build: .
    ports:
      - "5000:5000"
    environment:
      - NODE_ENV=production
      - PORT=5000
    env_file:
      - .env.production
    volumes:
      - ./logs:/app/logs
      - ./uploads:/app/uploads
    restart: unless-stopped
    networks:
      - mentorship-network

  # Add Redis for Socket.IO adapter in production
  redis:
    image: redis:alpine
    ports:
      - "6379:6379"
    volumes:
      - redis-data:/data
    networks:
      - mentorship-network
    restart: unless-stopped

volumes:
  redis-data:

networks:
  mentorship-network:
    driver: bridge